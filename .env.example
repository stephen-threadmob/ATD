# =============================================================================
# ATD Baseball Platform — environment variables
# Copy to .env.local for development. Never commit a filled-in copy.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Direct Postgres connection. In production use Supabase's SESSION pooler
# (port 5432), NOT the transaction pooler: the booking engine relies on
# transaction-scoped state and advisory behaviour that PgBouncer's transaction
# mode does not preserve.
DATABASE_URL=postgresql://postgres:password@localhost:5432/atd
PGPOOL_MAX=10
# Set to `require` when connecting to a managed Postgres over the public internet.
PGSSL=

# --- Supabase (auth, storage, realtime) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Bypasses RLS. Never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=whsec_...
# Pin deliberately; upgrading is a tested change, not an implicit one.
STRIPE_API_VERSION=2025-02-24.acacia

# --- Email (choose one) ------------------------------------------------------
RESEND_API_KEY=re_...
# POSTMARK_SERVER_TOKEN=...
EMAIL_FROM="ATD Baseball <no-reply@atdbaseball.com>"
EMAIL_REPLY_TO=info@atdbaseball.com

# --- SMS ---------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_MESSAGING_SERVICE_SID=MG...
# Appended to marketing-class SMS for TCPA compliance.
SMS_OPT_OUT_TEXT="Reply STOP to opt out."

# --- Background jobs ---------------------------------------------------------
# Shared secret required by /api/jobs/* so only the scheduler can trigger them.
JOB_RUNNER_SECRET=generate-a-long-random-string

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCATION_SLUG=atd-main
# Google Calendar two-way sync for coaches (optional).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
